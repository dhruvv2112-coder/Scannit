# Scannit Platform — environment variables
# Copy to .env and adjust values for your environment.

# PostgreSQL
SCANNIT_DATABASE_URL=postgresql+asyncpg://scannit:scannit@db:5432/scannit

# Redis (Celery broker)
SCANNIT_REDIS_URL=redis://redis:6379/0

# S3 / MinIO
SCANNIT_S3_ENDPOINT_URL=http://minio:9000
SCANNIT_S3_ACCESS_KEY=minioadmin
SCANNIT_S3_SECRET_KEY=minioadmin
SCANNIT_S3_BUCKET=scannit-artifacts

# CORS origins (comma-separated in env, list in config)
# SCANNIT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Debug mode
SCANNIT_DEBUG=false
