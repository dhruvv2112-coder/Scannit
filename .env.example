# Scannit Platform — Environment Variables
# Copy to .env and adjust for your environment. Never commit .env.

# --- Postgres (PostGIS) ---
SCANNIT_DATABASE_URL=postgresql+asyncpg://scannit:scannit@localhost:5432/scannit

# --- Redis ---
SCANNIT_REDIS_URL=redis://localhost:6379/0

# --- S3 / MinIO ---
SCANNIT_S3_ENDPOINT_URL=http://localhost:9000
SCANNIT_S3_ACCESS_KEY=minioadmin
SCANNIT_S3_SECRET_KEY=minioadmin
SCANNIT_S3_BUCKET=scannit-artifacts

# --- CORS ---
SCANNIT_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Application ---
SCANNIT_DEBUG=true
SCANNIT_APP_VERSION=0.1.0

# --- Celery / Orchestrator ---
SCANNIT_API_URL=http://localhost:8000
SCANNIT_DATA_ROOT=/data
